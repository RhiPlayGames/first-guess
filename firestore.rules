rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isLeagueMember(leagueData) {
      return signedIn() &&
             request.auth.uid in leagueData.memberIds;
    }

    function isLeagueMemberById(leagueId) {
      return signedIn() &&
             request.auth.uid in
               get(/databases/$(database)/documents/leagues/$(leagueId))
                 .data.memberIds;
    }

    function approvedName(scope, name) {
      return signedIn() &&
        name is string &&
        exists(/databases/$(database)/documents/name_approvals/$(request.auth.uid)/scopes/$(scope)) &&
        get(/databases/$(database)/documents/name_approvals/$(request.auth.uid)/scopes/$(scope)).data.name == name &&
        get(/databases/$(database)/documents/name_approvals/$(request.auth.uid)/scopes/$(scope)).data.approvedAt >
          request.time - duration.value(10, 'm');
    }

    // The saved profile is the authoritative name. The fallback supports
    // leaderboard entries for players who have not chosen a profile name yet.
    function matchesPlayerName(userId, suppliedName) {
      return signedIn() && suppliedName is string &&
        (
          (
            exists(/databases/$(database)/documents/players/$(userId)/profile/public_profile) &&
            get(/databases/$(database)/documents/players/$(userId)/profile/public_profile).data.get('displayName', '') is string &&
            (
              (
                get(/databases/$(database)/documents/players/$(userId)/profile/public_profile).data.get('displayName', '') != '' &&
                suppliedName == get(/databases/$(database)/documents/players/$(userId)/profile/public_profile).data.displayName
              ) ||
              (
                get(/databases/$(database)/documents/players/$(userId)/profile/public_profile).data.get('displayName', '') == '' &&
                suppliedName == 'Player'
              )
            )
          ) ||
          (
            !exists(/databases/$(database)/documents/players/$(userId)/profile/public_profile) &&
            suppliedName == 'Player'
          )
        );
    }

    match /challenges/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /daily_flash_questions/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Only a trusted Cloud Function (Admin SDK) can create approvals.
    match /name_approvals/{uid}/scopes/{scope} {
      allow read, write: if false;
    }

    match /players/{userId}/progress/{document=**} {
      allow read, write: if signedIn() &&
                         request.auth.uid == userId;
    }

    match /players/{userId}/case_paths/{document=**} {
      allow read, write: if signedIn() &&
                         request.auth.uid == userId;
    }

    match /players/{userId}/profile/public_profile {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId &&
        (
          !request.resource.data.keys().hasAny(['displayName']) ||
          approvedName('player', request.resource.data.displayName)
        );
      allow update: if signedIn() && request.auth.uid == userId &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
          (
            (!resource.data.keys().hasAny(['displayName']) || resource.data.displayName == '') &&
            approvedName('player', request.resource.data.displayName)
          )
        );
      allow delete: if false;
    }

    match /player_names/{normalisedName} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.normalisedName == normalisedName &&
        approvedName('player', request.resource.data.displayName);
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.normalisedName == normalisedName &&
        request.resource.data.displayName == resource.data.displayName;
      allow delete: if false;
    }

    match /players/{userId}/leaderboard/{documentId} {
      allow read: if signedIn();
      allow write: if signedIn() &&
                   request.auth.uid == userId &&
                   (
                     documentId == 'public_stats' ||
                     documentId.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$') ||
                     documentId.matches('^monthly_[0-9]{4}-[0-9]{2}$')
                   ) &&
                   (
                     !request.resource.data.keys().hasAny(['displayName']) ||
                     matchesPlayerName(userId, request.resource.data.displayName)
                   );
    }

    match /global_leaderboards/{periodId} {
      allow read: if signedIn();

      match /players/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() &&
                              request.auth.uid == userId &&
                              request.resource.data.userId == request.auth.uid &&
                              matchesPlayerName(userId, request.resource.data.displayName) &&
                              (
                                periodId == 'all_time' ||
                                periodId.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$') ||
                                periodId.matches('^monthly_[0-9]{4}-[0-9]{2}$')
                              );
        allow delete: if false;
      }

      match /rank_snapshots/{snapshotId} {
        allow read: if signedIn();
        allow write: if signedIn() &&
                     snapshotId == 'current' &&
                     (
                       periodId == 'all_time' ||
                       periodId.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$') ||
                       periodId.matches('^monthly_[0-9]{4}-[0-9]{2}$')
                     );
      }
    }

    match /leagues/{leagueId} {
      allow read: if isLeagueMember(resource.data);

      allow create: if signedIn() &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.memberCount == 1 &&
                    request.resource.data.memberIds == [request.auth.uid] &&
                    request.resource.data.inviteCode is string &&
                    request.resource.data.inviteCode.size() > 0 &&
                    approvedName('league', request.resource.data.name);

      // Owners can update presentation, but cannot rename a league.
      allow update: if signedIn() &&
                    resource.data.ownerId == request.auth.uid &&
                    request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly(['badgePath', 'accentColor', 'updatedAt']);

      allow update: if signedIn() &&
                    !(request.auth.uid in resource.data.memberIds) &&
                    request.auth.uid in request.resource.data.memberIds &&
                    request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
                    request.resource.data.memberIds.size() ==
                      resource.data.memberIds.size() + 1 &&
                    request.resource.data.memberCount == resource.data.memberCount + 1 &&
                    request.resource.data.lastJoinCode is string &&
                    getAfter(
                      /databases/$(database)/documents/league_invites/$(request.resource.data.lastJoinCode)
                    ).data.leagueId == leagueId &&
                    request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly(['memberIds', 'memberCount', 'lastJoinCode', 'updatedAt']);

      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn() &&
                    (
                      request.auth.uid == userId ||
                      isLeagueMemberById(leagueId)
                    );

        allow create: if signedIn() &&
                      request.auth.uid == userId &&
                      request.resource.data.userId == userId &&
                      matchesPlayerName(userId, request.resource.data.displayName) &&
                      request.auth.uid in
                        getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds &&
                      (
                        (
                          getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == userId &&
                          request.resource.data.role == 'owner'
                        ) ||
                        (
                          getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId != userId &&
                          request.resource.data.role == 'member'
                        )
                      );

        allow update: if signedIn() &&
                      request.auth.uid == userId &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.joinedAt == resource.data.joinedAt &&
                      (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
                        matchesPlayerName(userId, request.resource.data.displayName)
                      ) &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['displayName', 'avatarPath', 'schemaVersion']);
        allow delete: if false;
      }

      match /rank_snapshots/{snapshotId} {
        allow read: if isLeagueMemberById(leagueId);
        allow write: if isLeagueMemberById(leagueId) &&
                     (
                       snapshotId == 'all_time' ||
                       snapshotId.matches('^daily_[0-9]{4}-[0-9]{2}-[0-9]{2}$') ||
                       snapshotId.matches('^monthly_[0-9]{4}-[0-9]{2}$')
                     );
      }
    }

    match /league_invites/{inviteCode} {
      allow read: if signedIn();

      allow create: if signedIn() &&
                    request.resource.data.createdBy == request.auth.uid &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.inviteCode == inviteCode &&
                    getAfter(
                      /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
                    ).data.ownerId == request.auth.uid &&
                    getAfter(
                      /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
                    ).data.inviteCode == inviteCode &&
                    request.resource.data.leagueName == getAfter(
                      /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
                    ).data.name &&
                    request.resource.data.badgePath == getAfter(
                      /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
                    ).data.badgePath &&
                    request.resource.data.accentColor == getAfter(
                      /databases/$(database)/documents/leagues/$(request.resource.data.leagueId)
                    ).data.accentColor;

      allow update: if signedIn() &&
                    request.resource.data.leagueId == resource.data.leagueId &&
                    request.resource.data.inviteCode == resource.data.inviteCode &&
                    request.resource.data.memberCount == resource.data.memberCount + 1 &&
                    !(request.auth.uid in
                      get(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.memberIds) &&
                    request.auth.uid in
                      getAfter(/databases/$(database)/documents/leagues/$(resource.data.leagueId)).data.memberIds &&
                    request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly(['memberCount', 'updatedAt']);
      allow delete: if false;
    }
  }
}
